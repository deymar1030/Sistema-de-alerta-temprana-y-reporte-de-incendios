PORT=3000
NODE_ENV=development

# PostgreSQL — usado por Prisma (prisma.config.ts y prismaClient.js)
DATABASE_URL="postgresql://usuario:password@localhost:5432/alerta_incendios?schema=public"

CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
COOKIE_SAMESITE=lax
COOKIE_SECURE=
TRUST_PROXY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=backend
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_CA_FILE=
MOTOR_CONFIG_PATH=

MQTT_AUTH_SECRET=
MQTT_AUTH_BACKEND_HOST=host.docker.internal
MQTT_AUTH_BACKEND_PORT=3000

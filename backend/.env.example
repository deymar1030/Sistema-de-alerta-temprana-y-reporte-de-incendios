PORT=3000
NODE_ENV=development

# PostgreSQL — usado por Prisma (prisma.config.ts y prismaClient.js)
DATABASE_URL="postgresql://usuario:password@localhost:5432/alerta_incendios?schema=public"

# --- Autenticacion por sesiones (cookie) ---
# Origen(es) del frontend, separados por coma. Debe ser explicito (no "*").
CORS_ORIGIN=http://localhost:5173
# Duracion maxima de una sesion (horas) y cierre por inactividad (minutos)
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
# SameSite de la cookie: lax (recomendado) | strict | none (none exige HTTPS)
COOKIE_SAMESITE=lax
# Secure de la cookie: vacio = automatico (activo en NODE_ENV=production)
COOKIE_SECURE=
# 1 si el backend va detras de un proxy inverso (Coolify/Nginx/Traefik)
TRUST_PROXY=
# Bloqueo de cuenta tras N intentos fallidos, por M minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Intentos de login fallidos permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT_MAX=20

# --- Broker MQTT (Mosquitto) --- (ver docs/TopicosMQTT.md)
# Solo autenticacion por usuario/contrasena, sin ACL por topico.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=backend
MQTT_USERNAME=backend
MQTT_PASSWORD=

# Copia este archivo como ".env" (sin .example) y completa tus datos.
# El archivo .env NUNCA se sube a GitHub.

# Backend (API) -- pidele la URL a tu supervisor
SIMULADOR_BACKEND_URL=PON_AQUI_LA_URL_DEL_BACKEND
# Usuario de SIMULACION registrado en el sistema (pidele uno a tu supervisor
# o registralo con POST /api/auth/register). No uses la cuenta admin.
SIMULADOR_CORREO=PON_AQUI_EL_CORREO_DE_SIMULACION
SIMULADOR_CONTRASENA=PON_AQUI_LA_CONTRASENA

# Broker MQTT del VPS (con TLS) -- pidele la URL a tu supervisor
MQTT_BROKER_URL=PON_AQUI_LA_URL_DEL_BROKER_MQTT
# server.crt debe estar en esta misma carpeta (pidelo a tu supervisor, no se sube a GitHub)
MQTT_CA_FILE=server.crt
